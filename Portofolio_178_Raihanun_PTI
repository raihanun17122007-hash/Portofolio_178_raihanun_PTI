  <!-- Bagian awal -->
  <section class="hero" id="beranda">
    <div class="hero-inner">
      <div class="hero-text">
        <h1>Raihanun</h1>
        <p class="role">Lulusan SMA Negeri 1 Woja</p>
        <p class="lead">
          Bendahara OSIS, juara lomba akademik tingkat kabupaten, dan penulis
